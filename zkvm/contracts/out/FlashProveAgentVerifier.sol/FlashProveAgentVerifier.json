"name\":\"\",\"type\":\"uint16\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"agentProofProfile\",\"outputs\":[{\"internalType\":\"bytes32\",\"name\":\"\",\"type\":\"bytes32\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"bytes32\",\"name\":\"\",\"type\":\"bytes32\"}],\"name\":\"authorizedAgents\",\"outputs\":[{\"internalType\":\"bool\",\"name\":\"\",\"type\":\"bool\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"bytes\",\"name\":\"proof\",\"type\":\"bytes\"},{\"internalType\":\"bytes32\",\"name\":\"inputHash\",\"type\":\"bytes32\"},{\"internalType\":\"bytes32\",\"name\":\"outputHash\",\"type\":\"bytes32\"}],\"name\":\"checkBinding\",\"outputs\":[{\"internalType\":\"bool\",\"name\":\"\",\"type\":\"bool\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"commitmentId\",\"outputs\":[{\"internalType\":\"bytes32\",\"name\":\"\",\"type\":\"bytes32\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"metadata\",\"outputs\":[{\"internalType\":\"bytes\",\"name\":\"\",\"type\":\"bytes\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"requireStatusZero\",\"outputs\":[{\"internalType\":\"bool\",\"name\":\"\",\"type\":\"bool\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"bytes4\",\"name\":\"interfaceId\",\"type\":\"bytes4\"}],\"name\":\"supportsInterface\",\"outputs\":[{\"internalType\":\"bool\",\"name\":\"\",\"type\":\"bool\"}],\"stateMutability\":\"pure\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"bytes32\",\"name\":\"\",\"type\":\"bytes32\"}],\"name\":\"usedTasks\",\"outputs\":[{\"internalType\":\"bool\",\"name\":\"\",\"type\":\"bool\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"verifier\",\"outputs\":[{\"internalType\":\"contract IProofVerifier\",\"name\":\"\",\"type\":\"address\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"bytes32\",\"name\":\"taskId\",\"type\":\"bytes32\"},{\"internalType\":\"bytes32\",\"name\":\"agentId\",\"type\":\"bytes32\"},{\"internalType\":\"bytes32\",\"name\":\"inputHash\",\"type\":\"bytes32\"},{\"internalType\":\"bytes32\",\"name\":\"outputHash\",\"type\":\"bytes32\"},{\"internalType\":\"bytes\",\"name\":\"proof\",\"type\":\"bytes\"}],\"name\":\"verify\",\"outputs\":[{\"internalType\":\"bool\",\"name\":\"valid\",\"type\":\"bool\"},{\"internalType\":\"bytes32\",\"name\":\"verificationDigest\",\"type\":\"bytes32\"}],\"stateMutability\":\"nonpayable\",\"type\":\"function\"}],\"devdoc\":{\"kind\":\"dev\",\"methods\":{\"verify(bytes32,bytes32,bytes32,bytes32,bytes)\":{\"returns\":{\"valid\":\"             Whether the agent is authorized and the proof is valid.\",\"verificationDigest\":\"Hash of the event's fields, returned whatever the outcome.\"}}},\"title\":\"FlashProveAgentVerifier \\u2014 ERC-8274 IAgentVerifier for FlashProve\",\"version\":1},\"userdoc\":{\"events\":{\"VerificationCompleted(bytes32,bytes32,bytes32,bool,bytes32,bytes32,bytes32,uint256,bytes,bytes)\":{\"notice\":\"SHOULD be emitted on every verify() call, passing and failing.\"}},\"kind\":\"user\",\"methods\":{\"acceptedVerdicts()\":{\"notice\":\"Bit `code` set for each accepted FPV1 verdict code.\"},\"checkBinding(bytes,bytes32,bytes32)\":{\"notice\":\"The application checks on the decoded FPV1 block. External so `verify` can turn a         malformed block into `valid = false` instead of a revert.\"},\"commitmentId()\":{\"notice\":\"The FlashProve commitment ID this deployment verifies.\"},\"metadata()\":{\"notice\":\"The invariant metadata passed to the inner verifier: abi.encode(programVKey).\"},\"requireStatusZero()\":{\"notice\":\"Whether an accepted call must also have call status zero.\"},\"verifier()\":{\"notice\":\"The inner proof-system verifier.\"},\"verify(bytes32,bytes32,bytes32,bytes32,bytes)\":{\"notice\":\"Verify an agent's inference claim for a specific task.\"}},\"notice\":\"The outer, stateful layer. It binds one IProofVerifier, one program vkey (`metadata`),         one commitment ID and one accepted-verdict mask, and authorizes a set of agents.         A successful verification consumes the task ID; a failed one may be retried.         `proof` is the SP1 bundle `abi.encode(bytes publicValues, bytes sp1Proof)`. The inner         verifier proves that the SP1 circuit produced those public values for the configured         program; this contract additionally requires:           * the block's commitment ID equals the configured one,           * its verdict is in the accepted mask,           * its call status is zero (when `requireStatusZero`),           * its input and result-v1 digests equal the caller's `inputHash` and `outputHash`.         `verificationDigest` and the `VerificationCompleted` event follow ERC-8274 exactly.\",\"version\":1}},\"settings\":{\"compilationTarget\":{\"src/FlashProveAgentVerifier.sol\":\"FlashProveAgentVerifier\"},\"evmVersion\":\"cancun\",\"libraries\":{},\"metadata\":{\"bytecodeHash\":\"ipfs\"},\"optimizer\":{\"enabled\":true,\"runs\":200},\"remappings\":[],\"viaIR\":true},\"sources\":{\"src/FlashProveAgentVerifier.sol\":{\"keccak256\":\"0x326cdf69b520794b5e54930e99c26389e5207a0d9e62d04395bea75fe77f9767\",\"license\":\"MIT\",\"urls\":[\"bzz-raw://cff75f9eabe07e0ab3029efcbec69d901b444c420aa4737e5627e4a3252802db\",\"dweb:/ipfs/QmPi6Z56RwGfvZtbwbDSHWCj5NGW3iTdyUpw7ynsHZmEpV\"]},\"src/interfaces/IAgentVerifier.sol\":{\"keccak256\":\"0x637e81d6acb209974bc2f01593c0d1c7a6fbd04776f297e232395acccd721b40\",\"license\":\"MIT\",\"urls\":[\"bzz-raw://0615d2a63be80d213e79a9ae66a4357ff745d3ec3957a6025afd6c5866235a6c\",\"dweb:/ipfs/QmYXAUeTTXcczpuA1pqmtx5LiqXzFkDS9eQF559y2NwdsU\"]},\"src/interfaces/IERC165.sol\":{\"keccak256\":\"0xbf3bb6fec0b1d956cc8d3c249c62613c2ddb441a76ad16add7d8a2dde1fbb8bb\",\"license\":\"MIT\",\"urls\":[\"bzz-raw://